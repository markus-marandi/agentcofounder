{
  "route": "web-app",
  "product": {
    "name": "Records",
    "tagline": "Keep track of the things that matter to you.",
    "description": "A neutral starting point. The analyzer skill rewrites this file from the product idea before any component is written."
  },
  "theme": {
    "preset": "tech-innovation",
    "density": "comfortable"
  },
  "navigation": [
    {
      "id": "collection",
      "label": "All records",
      "kind": "collection",
      "entity": "record"
    },
    { "id": "dashboard-preview", "label": "Dashboard", "kind": "content" },
    { "id": "calendar-preview", "label": "Calendar", "kind": "content" },
    { "id": "documents-preview", "label": "Documents", "kind": "content" },
    { "id": "reports-preview", "label": "Reports", "kind": "content" }
  ],
  "entities": [
    {
      "name": "record",
      "label": "Record",
      "labelPlural": "Records",
      "titleField": "title",
      "fields": [
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "required": true
        },
        {
          "name": "category",
          "label": "Category",
          "type": "combobox",
          "options": [
            "General",
            "Personal",
            "Work"
          ],
          "help": "Pick one of the suggestions or type your own."
        },
        {
          "name": "amount",
          "label": "Amount",
          "type": "number",
          "min": 0
        },
        {
          "name": "done",
          "label": "Done",
          "type": "boolean"
        },
        {
          "name": "completedOn",
          "label": "Completed on",
          "type": "date"
        }
      ],
      "filters": [
        {
          "field": "category",
          "label": "Category",
          "mode": "equals"
        },
        {
          "field": "done",
          "label": "Done only",
          "mode": "truthy"
        }
      ],
      "actions": [
        {
          "id": "complete",
          "label": "Mark done",
          "sets": {
            "done": true,
            "completedOn": "@today"
          },
          "when": {
            "field": "done",
            "mode": "falsy"
          },
          "style": "primary"
        },
        {
          "id": "reopen",
          "label": "Reopen",
          "sets": {
            "done": false,
            "completedOn": null
          },
          "when": {
            "field": "done",
            "mode": "truthy"
          }
        }
      ],
      "sort": {
        "field": "title",
        "direction": "asc"
      },
      "derived": [
        {
          "id": "total",
          "label": "Records",
          "kind": "count"
        },
        {
          "id": "outstanding",
          "label": "Not done",
          "kind": "countWhere",
          "where": {
            "field": "done",
            "mode": "falsy"
          }
        }
      ]
    }
  ],
  "features": {
    "search": true,
    "auth": false,
    "limitations": []
  },
  "persistence": {
    "adapter": "localStorage",
    "namespace": "records"
  },
  "components": {
    "collectionView": true,
    "recordForm": true,
    "field": true,
    "emptyState": true,
    "statRow": true,
    "dashboardGrid": false,
    "chart": false,
    "landingPage": false,
    "prototypeFlow": false,
    "authBar": false
  }
}
