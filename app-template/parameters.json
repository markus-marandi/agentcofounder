{
  "route": "web-app",
  "product": {
    "name": "Records",
    "tagline": "Keep track of the things that matter to you.",
    "description": "A neutral, valid structural example. Rewrite its product decisions from the idea and preserve the demonstrated configuration shapes."
  },
  "theme": {
    "preset": "tech-innovation",
    "density": "comfortable"
  },
  "navigation": [
    {
      "id": "collection",
      "label": "All records",
      "kind": "collection",
      "entity": "record"
    },
    {
      "id": "dashboard-preview",
      "label": "Dashboard",
      "kind": "content",
      "body": "A place for a summary view. Add a dashboard entry and a dashboard block to parameters.json to fill it with real plots over your records."
    },
    {
      "id": "calendar-preview",
      "label": "Calendar",
      "kind": "content",
      "body": "A place for anything date-shaped in your records. Nothing here is scheduled for you: the dates come from the fields you declared."
    },
    {
      "id": "documents-preview",
      "label": "Documents",
      "kind": "content",
      "body": "Notes and reference material that sit beside the collection rather than inside it."
    },
    {
      "id": "reports-preview",
      "label": "Reports",
      "kind": "content",
      "body": "What the numbers above add up to over time. The totals on the collection screen are the live version."
    }
  ],
  "entities": [
    {
      "name": "record",
      "label": "Record",
      "labelPlural": "Records",
      "titleField": "title",
      "fields": [
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "required": true
        },
        {
          "name": "category",
          "label": "Category",
          "type": "combobox",
          "options": [
            "General",
            "Personal",
            "Work"
          ],
          "help": "Pick one of the suggestions or type your own."
        },
        {
          "name": "amount",
          "label": "Amount",
          "type": "number",
          "min": 0
        },
        {
          "name": "done",
          "label": "Done",
          "type": "boolean"
        },
        {
          "name": "completedOn",
          "label": "Completed on",
          "type": "date"
        }
      ],
      "filters": [
        {
          "field": "category",
          "label": "Category",
          "mode": "equals"
        },
        {
          "field": "done",
          "label": "Done only",
          "mode": "truthy"
        }
      ],
      "actions": [
        {
          "id": "complete",
          "label": "Mark done",
          "sets": {
            "done": true,
            "completedOn": "@today"
          },
          "when": {
            "field": "done",
            "mode": "falsy"
          },
          "style": "primary"
        },
        {
          "id": "reopen",
          "label": "Reopen",
          "sets": {
            "done": false,
            "completedOn": null
          },
          "when": {
            "field": "done",
            "mode": "truthy"
          }
        }
      ],
      "sort": {
        "field": "title",
        "direction": "asc"
      },
      "derived": [
        {
          "id": "total",
          "label": "Records",
          "kind": "count"
        },
        {
          "id": "outstanding",
          "label": "Not done",
          "kind": "countWhere",
          "where": {
            "field": "done",
            "mode": "falsy"
          }
        }
      ]
    }
  ],
  "features": {
    "search": true,
    "auth": false,
    "limitations": [
      "Your records live only in this browser on this device. Nothing syncs to another browser or another machine, and clearing site data clears the list.",
      "There are no accounts. Anyone using this browser profile sees and edits the same records."
    ]
  },
  "persistence": {
    "adapter": "localStorage",
    "namespace": "records"
  },
  "components": {
    "collectionView": true,
    "recordForm": true,
    "field": true,
    "emptyState": true,
    "statRow": true,
    "dashboardGrid": false,
    "chart": false,
    "landingPage": false,
    "prototypeFlow": false,
    "authBar": false
  }
}
