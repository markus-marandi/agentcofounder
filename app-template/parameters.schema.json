{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated application parameters",
  "description": "Assembly contract for the prebuilt kernel. The analyzer skill writes this file; the kernel reads it to lay out navigation, theming, entities, and route-specific sections.",
  "type": "object",
  "additionalProperties": false,
  "required": ["route", "product", "theme", "navigation", "entities", "features", "persistence"],
  "properties": {
    "route": {
      "description": "Build route chosen by the analyzer skill.",
      "enum": ["landing-page", "web-app", "prototype", "mock-dashboard", "open-build"]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tagline"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 600 }
      }
    },
    "theme": {
      "description": "Kept for compatibility. The palette is fixed — neutral gray chrome, indigo accent, in every generated app — so preset and accent no longer change a colour; only density is still read.",
      "type": "object",
      "additionalProperties": false,
      "required": ["preset"],
      "properties": {
        "preset": {
          "enum": [
            "modern-minimalist",
            "arctic-frost",
            "tech-innovation",
            "ocean-depths",
            "forest-canopy",
            "botanical-garden",
            "golden-hour",
            "sunset-boulevard",
            "desert-rose",
            "midnight-galaxy"
          ]
        },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "density": { "enum": ["comfortable", "compact"] }
      }
    },
    "navigation": {
      "description": "Menu entries, listed in the sidebar rail. The chrome itself is fixed — every generated app has the rail, the search header, and day/night regardless of how many entries there are; these decide only what the rail contains. Fill the menu out to at least four entries so it does not read as unfinished.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 32 },
          "kind": { "enum": ["collection", "dashboard", "landing", "screen", "content"] },
          "entity": { "type": "string" },
          "screen": { "type": "string" }
        }
      }
    },
    "entities": {
      "description": "Persisted record types. At least one is required on every route, including landing pages and prototypes.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "label", "labelPlural", "fields"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "label": { "type": "string", "minLength": 1 },
          "labelPlural": { "type": "string", "minLength": 1 },
          "titleField": { "type": "string" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "label", "type"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
                "label": { "type": "string", "minLength": 1 },
                "type": { "enum": ["text", "longtext", "number", "date", "select", "combobox", "boolean"] },
                "required": { "type": "boolean" },
                "unique": { "type": "boolean" },
                "options": { "type": "array", "items": { "type": "string" } },
                "min": { "type": "number" },
                "max": { "type": "number" },
                "help": { "type": "string" }
              }
            }
          },
          "filters": {
            "description": "Fields the collection can be narrowed by. At least one is required by the delivery floor.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "label"],
              "properties": {
                "field": { "type": "string" },
                "label": { "type": "string" },
                "mode": { "enum": ["equals", "truthy", "falsy", "contains"] }
              }
            }
          },
          "actions": {
            "description": "One-click changes to a single record, offered in its row. This is where a verb the idea states but a form expresses badly belongs: \"mark it returned\", \"note who borrowed it\", \"mark paid\". Give each action a `when` clause so it is only offered on records it makes sense for.",
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "label": { "type": "string", "minLength": 1, "maxLength": 32 },
                "prompt": {
                  "description": "Name of a declared field collected inline before the action applies.",
                  "type": "string"
                },
                "sets": {
                  "description": "Field values written when the action runs. \"@today\" and \"@now\" resolve at click time; null clears a field.",
                  "type": "object",
                  "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
                },
                "when": {
                  "description": "Offer the action only on records that match.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["field", "mode"],
                  "properties": {
                    "field": { "type": "string" },
                    "mode": { "enum": ["equals", "truthy", "falsy", "contains"] },
                    "value": {}
                  }
                },
                "confirm": { "type": "boolean" },
                "style": { "enum": ["default", "primary", "danger"] }
              }
            }
          },
          "sort": {
            "description": "Resting order of the collection. Omit for insertion order.",
            "type": "object",
            "additionalProperties": false,
            "required": ["field"],
            "properties": {
              "field": { "type": "string" },
              "direction": { "enum": ["asc", "desc"] }
            }
          },
          "derived": {
            "description": "Computed values shown above the collection. At least one is required by the delivery floor.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "kind"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "label": { "type": "string" },
                "kind": { "enum": ["count", "countWhere", "sum", "average", "min", "max", "distinct"] },
                "field": { "type": "string" },
                "where": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["field", "mode"],
                  "properties": {
                    "field": { "type": "string" },
                    "mode": { "enum": ["equals", "truthy", "falsy", "contains"] },
                    "value": {}
                  }
                }
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search": { "type": "boolean" },
        "auth": { "type": "boolean" },
        "limitations": {
          "description": "Boundaries a user can actually reach, surfaced in the interface rather than hidden in a report.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main", "sub"],
      "properties": {
        "main": { "$ref": "#/definitions/plot" },
        "sub": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/definitions/plot" }
        }
      }
    },
    "landing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections", "captureEntity"],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["hero", "subhero", "features", "comparison", "social-proof", "faq", "cta"] }
        },
        "captureEntity": { "type": "string" },
        "callToAction": { "type": "string" },
        "comparisonSet": { "type": "string" }
      }
    },
    "prototype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screens"],
      "properties": {
        "screens": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "collects": { "type": "array", "items": { "type": "string" } },
              "next": { "type": "string" },
              "back": { "type": "string" }
            }
          }
        },
        "entity": { "type": "string" }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "namespace"],
      "properties": {
        "adapter": { "enum": ["localStorage", "memory"] },
        "namespace": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "components": {
      "description": "Audit trail of which src/ui/* components this configuration reaches. Documented in app-template/COMPONENTS.md. Not consumed by the kernel: the real switches are navigation[].kind, the dashboard/landing/prototype blocks, and features.auth. Keep this in sync with those by hand.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collectionView": { "type": "boolean" },
        "dashboardGrid": { "type": "boolean" },
        "landingPage": { "type": "boolean" },
        "prototypeFlow": { "type": "boolean" },
        "authBar": { "type": "boolean" },
        "chart": { "type": "boolean" },
        "recordForm": { "type": "boolean" },
        "field": { "type": "boolean" },
        "emptyState": { "type": "boolean" },
        "statRow": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["line", "area", "bar", "donut", "sparkline", "stat"] },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["timeseries", "categorical", "entityCount", "entityGroup", "entitySum"] },
            "entity": { "type": "string" },
            "field": { "type": "string" },
            "points": { "type": "integer", "minimum": 2, "maximum": 366 },
            "categories": { "type": "array", "items": { "type": "string" } },
            "seed": { "type": "integer" },
            "trend": { "enum": ["up", "down", "flat", "volatile"] }
          }
        },
        "unit": { "type": "string" }
      }
    }
  }
}
